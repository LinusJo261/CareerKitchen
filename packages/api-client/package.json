{
  "name": "@career-kitchen/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json -o src/schema.ts --alphabetize",
    "check:generated": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": { "openapi-fetch": "0.17.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22" }
}

