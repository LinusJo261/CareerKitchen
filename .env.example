# Development: copy to .env, replace every placeholder with an independent random secret.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://career_kitchen:REPLACE_DATABASE_PASSWORD@127.0.0.1:55432/career_kitchen
# Owner URL belongs only in the separately credentialed migration/release job.
# Do not set this in the production API or worker environment.
MIGRATION_DATABASE_URL=
LOCAL_DATABASE_PASSWORD=REPLACE_DATABASE_PASSWORD
AUTH_MODE=supabase
ALLOW_DEV_AUTH=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_ONLY_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
JWT_MAX_LIFETIME_SECONDS=3600
# Fernet.generate_key().decode(); database, JWT, Fernet, audit and readiness keys must differ.
ENCRYPTION_KEY=REPLACE_FERNET_KEY
AUDIT_HMAC_KEY=REPLACE_32_OR_MORE_RANDOM_CHARACTERS
READINESS_TOKEN=REPLACE_32_OR_MORE_RANDOM_CHARACTERS
DEV_JWT_SECRET=REPLACE_32_OR_MORE_RANDOM_CHARACTERS
# Explicit development website and Swagger origins; hosted environments require HTTPS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FEATURE_MODE=LIVE
MATCHING_MODEL_MAX_AGE_DAYS=90
# Next.js server-only connection and optional canonical origin behind an HTTPS proxy.
CAREER_KITCHEN_API_URL=http://127.0.0.1:8000
CAREER_KITCHEN_SITE_URL=
# Explicit local-only fictional account selector. Disabled in production builds.
FRONTEND_LOCAL_DEMO=false
STORAGE_BACKEND=local
STORAGE_BUCKET=career-kitchen-private
LOCAL_STORAGE_DIR=.local/storage
# Binary documents require a reachable ClamAV service; plain UTF-8 is strictly sanitized.
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_RESUME_BYTES=5000000
RATE_LIMIT_PER_MINUTE=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
WORKER_POLL_SECONDS=1
# Persistent, versioned attention-controller windows and routing-unit clamps.
MARKET_PRICE_WINDOW_SECONDS=900
MARKET_PRICE_MAX=10
CONGESTION_PRICE_MAX=10

# Server-only Gemini navigation assistant. Empty key disables assistance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

